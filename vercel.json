{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/product", "destination": "/showroom.html", "permanent": true },
    { "source": "/category", "destination": "/showroom.html", "permanent": true },
    { "source": "/country", "destination": "/showroom.html", "permanent": true }
  ],
  "routes": [
    { "src": "^/api/social/publish(?:/.*)?$", "dest": "/api/social/admin?__path=/api/social/publish&" },
    { "src": "^/api/social/posts(?:/.*)?$", "dest": "/api/social/admin?__path=/api/social/posts&" },
    { "src": "^/api/social/accounts(?:/.*)?$", "dest": "/api/social/admin?__path=/api/social/accounts&" },
    { "src": "^/api/social/status(?:/.*)?$", "dest": "/api/social/admin?__path=/api/social/status&" },
    { "src": "^/api/social/scheduler(?:/.*)?$", "dest": "/api/social/admin?__path=/api/social/scheduler&" },
    { "src": "^/api/social/oauth/start(?:/.*)?$", "dest": "/api/social/oauth?__path=/api/social/oauth/start&" },
    { "src": "^/api/social/oauth/callback(?:/.*)?$", "dest": "/api/social/oauth?__path=/api/social/oauth/callback&" },
    { "src": "^/details$", "dest": "/details.html" },
    { "src": "^/product/([^/]+)$", "dest": "/api/og?id=$1" },
    { "src": "^/category/([^/]+)$", "dest": "/api/hub?type=category&slug=$1" },
    { "src": "^/country/([^/]+)$", "dest": "/api/hub?type=country&slug=$1" },
    { "src": "^/showroom$", "dest": "/showroom.html" },
    { "src": "^/(about|contact|team|help|privacy|terms|shipping-policy|refund-policy)$", "dest": "/$1.html" },
    { "src": "^/(checkout|payment|account|cart|auth|admin|admin-shipping|admin-domains|admin-video-scanner)$", "dest": "/$1.html" },
    { "src": "^/sitemap\\.xml$", "dest": "/api/sitemap.xml" },
    { "src": "^/merchant-feed\\.xml$", "dest": "/api/merchant-feed.xml" },
    { "src": "^/seo-audit$", "dest": "/api/seo-audit" },
    { "handle": "filesystem" }
  ],
  "functions": {
    "api/og-image.js": {
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg*"
    },
    "api/social/admin.js": { "maxDuration": 120 },
    "api/social/oauth.js": { "maxDuration": 30 }
  }
}